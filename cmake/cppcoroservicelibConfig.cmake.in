@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if("@CPP_CORO_IO_BACKEND@" STREQUAL "uring")
  include("${CMAKE_CURRENT_LIST_DIR}/CoroUring.cmake")
endif()
find_dependency(Boost 1.89 COMPONENTS json)
find_dependency(Threads)
find_dependency(OpenSSL)
find_dependency(yaml-cpp 0.7)
find_dependency(c-ares CONFIG)
if(@CPPCOROSERVICELIB_CRON_REQUIRES_LIBCRON@)
  find_dependency(libcron CONFIG)
endif()
if(@CPPCOROSERVICELIB_ENABLE_GRPC@)
  find_dependency(Protobuf CONFIG)
  find_dependency(gRPC CONFIG)
  find_dependency(asio-grpc CONFIG)
endif()
if(@CPPCOROSERVICELIB_ENABLE_KAFKA@)
  find_package(RdKafka CONFIG QUIET)
  if(NOT TARGET RdKafka::rdkafka)
    find_path(_cppcoroservicelib_rdkafka_include
        NAMES librdkafka/rdkafka.h rdkafka.h)
    find_library(_cppcoroservicelib_rdkafka_library NAMES rdkafka)
    if(NOT _cppcoroservicelib_rdkafka_include OR
       NOT _cppcoroservicelib_rdkafka_library)
      set(cppcoroservicelib_FOUND FALSE)
      set(cppcoroservicelib_NOT_FOUND_MESSAGE
          "librdkafka headers or library were not found")
      return()
    endif()
    add_library(RdKafka::rdkafka UNKNOWN IMPORTED)
    set_target_properties(RdKafka::rdkafka PROPERTIES
        IMPORTED_LOCATION "${_cppcoroservicelib_rdkafka_library}"
        INTERFACE_INCLUDE_DIRECTORIES
            "${_cppcoroservicelib_rdkafka_include}")
    unset(_cppcoroservicelib_rdkafka_include)
    unset(_cppcoroservicelib_rdkafka_library)
  endif()
endif()
if(@CPPCOROSERVICELIB_ENABLE_OTEL@)
  find_dependency(opentelemetry-cpp CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cppcoroservicelibTargets.cmake")

# Resolve the installed Boost target here rather than exporting the local
# boost_headers target created by FetchContent in a source build.
set_property(TARGET servicelib::coro_dns APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES Boost::headers)

if(@CPPCOROSERVICELIB_ENABLE_GRPC@ AND NOT TARGET servicelib::grpc)
  add_library(servicelib::grpc INTERFACE IMPORTED)
  set_property(TARGET servicelib::grpc PROPERTY INTERFACE_LINK_LIBRARIES
      servicelib::servicelib servicelib::coro_event_engine asio-grpc::asio-grpc gRPC::grpc++)
endif()

if(@CPPCOROSERVICELIB_ENABLE_KAFKA@ AND NOT TARGET servicelib::kafka)
  add_library(servicelib::kafka INTERFACE IMPORTED)
  set_property(TARGET servicelib::kafka PROPERTY INTERFACE_LINK_LIBRARIES
      servicelib::servicelib RdKafka::rdkafka)
endif()

if(@CPPCOROSERVICELIB_ENABLE_OTEL@ AND NOT TARGET servicelib::otel)
  add_library(servicelib::otel INTERFACE IMPORTED)
  set_property(TARGET servicelib::otel PROPERTY INTERFACE_LINK_LIBRARIES
      servicelib::servicelib
      opentelemetry-cpp::trace
      opentelemetry-cpp::logs
      opentelemetry-cpp::otlp_grpc_exporter
      opentelemetry-cpp::otlp_grpc_log_record_exporter
      opentelemetry-cpp::ostream_span_exporter)
endif()

if(TARGET yaml-cpp::yaml-cpp)
  set(_cppcoroservicelib_yaml_target yaml-cpp::yaml-cpp)
else()
  set(_cppcoroservicelib_yaml_target yaml-cpp)
endif()
set_property(TARGET servicelib::servicelib APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES
    Boost::headers Boost::json Threads::Threads
    ${_cppcoroservicelib_yaml_target})
unset(_cppcoroservicelib_yaml_target)
