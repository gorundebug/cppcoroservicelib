# Official nats.c; keep pin aligned with the canonical parent dependency manifest.
set(CPPCOROSERVICELIB_NATS_VERSION "v3.14.0" CACHE STRING "Official nats.c tag")
set(CPPCOROSERVICELIB_NATS_SHA256 "1f8b450bc295d0c94be201e34713ca0b515aae2c0d1b279273c3e6e0e72fe005")
option(CPPCOROSERVICELIB_ENABLE_NATS "Build native NATS Core/JetStream transport" OFF)
set(CPPCOROSERVICELIB_NATS_SOURCE_DIR "" CACHE PATH "Official nats.c source")
if(NOT CPPCOROSERVICELIB_ENABLE_NATS)
  return()
endif()
if(CPPCOROSERVICELIB_DEPENDENCY_MODE MATCHES "^(CONAN|SYSTEM)$")
  find_package(cnats 3.14.0 CONFIG REQUIRED GLOBAL)
  set(CPPCOROSERVICELIB_NATS_TARGET cnats::nats_static)
else()
  enable_language(C)
  set(NATS_BUILD_WITH_TLS ON CACHE BOOL "" FORCE)
  set(NATS_BUILD_STREAMING OFF CACHE BOOL "" FORCE)
  set(NATS_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(NATS_BUILD_LIB_SHARED OFF CACHE BOOL "" FORCE)
  set(NATS_BUILD_LIB_STATIC ON CACHE BOOL "" FORCE)
  set(_saved_testing "${BUILD_TESTING}")
  set(BUILD_TESTING OFF)
  if(CPPCOROSERVICELIB_DEPENDENCY_MODE STREQUAL "LOCAL")
    _servicelib_require_local(nats-c "${CPPCOROSERVICELIB_NATS_SOURCE_DIR}")
    add_subdirectory("${CPPCOROSERVICELIB_NATS_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/_deps/nats-c" EXCLUDE_FROM_ALL)
  else()
    FetchContent_Declare(nats-c
      URL "${CPPCOROSERVICELIB_GITHUB_ARCHIVE_BASE}/nats-io/nats.c/archive/refs/tags/${CPPCOROSERVICELIB_NATS_VERSION}.tar.gz"
      URL_HASH "SHA256=${CPPCOROSERVICELIB_NATS_SHA256}"
      DOWNLOAD_EXTRACT_TIMESTAMP FALSE)
    FetchContent_MakeAvailable(nats-c)
  endif()
  set(BUILD_TESTING "${_saved_testing}")
  set(CPPCOROSERVICELIB_NATS_TARGET nats_static)
endif()
