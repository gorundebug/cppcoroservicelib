{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CPPBOOSTSERVICELIB_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "asan",
      "inherits": "debug",
      "cacheVariables": {"CPPBOOSTSERVICELIB_ASAN": "ON"}
    },
    {
      "name": "ubsan",
      "inherits": "debug",
      "cacheVariables": {"CPPBOOSTSERVICELIB_UBSAN": "ON"}
    },
    {
      "name": "asan-ubsan",
      "inherits": "debug",
      "cacheVariables": {
        "CPPBOOSTSERVICELIB_ASAN": "ON",
        "CPPBOOSTSERVICELIB_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "cacheVariables": {"CPPBOOSTSERVICELIB_TSAN": "ON"}
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "cacheVariables": {"CPPBOOSTSERVICELIB_COVERAGE": "ON"}
    },
    {
      "name": "profiling",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CPPBOOSTSERVICELIB_PROFILING": "ON"
      }
    },
    {
      "name": "coroutine-diagnostics",
      "inherits": "profiling",
      "cacheVariables": {
        "CPPBOOSTSERVICELIB_COROUTINE_DIAGNOSTICS": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "ubsan", "configurePreset": "ubsan"},
    {"name": "asan-ubsan", "configurePreset": "asan-ubsan"},
    {"name": "tsan", "configurePreset": "tsan"},
    {"name": "coverage", "configurePreset": "coverage"},
    {"name": "profiling", "configurePreset": "profiling"},
    {"name": "coroutine-diagnostics", "configurePreset": "coroutine-diagnostics"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}},
    {"name": "ubsan", "configurePreset": "ubsan", "output": {"outputOnFailure": true}},
    {"name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": {"outputOnFailure": true}},
    {"name": "tsan", "configurePreset": "tsan", "output": {"outputOnFailure": true}},
    {"name": "coverage", "configurePreset": "coverage", "output": {"outputOnFailure": true}},
    {"name": "coroutine-diagnostics", "configurePreset": "coroutine-diagnostics", "output": {"outputOnFailure": true}}
  ]
}
